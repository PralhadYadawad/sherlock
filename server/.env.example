# Sherlock core — copy to .env (never commit real keys; DUMMY only).
SUPABASE_URL=https://DUMMY.supabase.co
SUPABASE_ANON_KEY=DUMMY_ANON_KEY
SUPABASE_SERVICE_KEY=DUMMY_SERVICE_KEY
# Preferred production region: India (ap-south-1 / Mumbai). See supabase/README.md.
SUPABASE_REGION=ap-south-1
SHERLOCK_DB=/tmp/opencode/sherlock.db
SHERLOCK_FIXTURES=demo-data/fixtures
